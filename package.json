{
  "name": "dsh-aide",
  "version": "0.9.1",
  "description": "AIDE (AI + IDE): VS Code-style local IDE for DeepSeek Harness with Monaco, explorer, search, Git and terminal",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrismScopes/dsh-aide.git"
  },
  "homepage": "https://github.com/PrismScopes/dsh-aide#readme",
  "bugs": {
    "url": "https://github.com/PrismScopes/dsh-aide/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs lib dist",
    "build": "node scripts/clean.mjs lib && tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:plugin": "pnpm build && node scripts/clean.mjs dist && pnpm pack --pack-destination dist",
    "perf": "node scripts/perf/index.mjs",
    "generate:file-icons": "node scripts/generate-file-icons.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/ripgrep": "^1.15.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^4.0.3",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.2.6",
    "katex": "^0.19.0",
    "marked": "^16.3.0",
    "marked-katex-extension": "^5.1.13",
    "material-icon-theme": "^5.39.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "4.10.38",
    "react-chrome-dino": "0.1.3",
    "typescript": "^5.9.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "aide",
    "ai",
    "ide",
    "monaco",
    "workbench"
  ],
  "author": {
    "name": "PrismScopes",
    "url": "https://github.com/PrismScopes"
  },
  "contributors": [
    {
      "name": "PrismScopes",
      "url": "https://github.com/PrismScopes"
    }
  ]
}
